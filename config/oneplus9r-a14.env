# config/oneplus9r-a14.env
CONFIG_ENV=config/oneplus9r-a14.env

KERNEL_SOURCE=https://github.com/OnePlusOSS/android_kernel_oneplus_sm8250
KERNEL_SOURCE_BRANCH=oneplus/sm8250_u_14.0.0_op9r
KERNEL_CONFIG=vendor/kona_defconfig
KERNEL_IMAGE_NAME=Image.gz-dtb
ARCH=arm64
KERNEL_NAME=

# Modern Android 14 kernel tree: use LLVM/clang
CLANG_BRANCH=master
CLANG_VERSION=
USE_LLVM=true
ENABLE_GCC_ARM64=false
ENABLE_GCC_ARM32=false
EXTRA_CMDS:LD=ld.lld
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

KSU_VARIANT=sukisu-ultra
KSU_REF=builtin
KSU_HOOK_MODE=kprobes
ENABLE_KPM=false

ENABLE_SUSFS=true
SUSFS_BRANCH=auto

# OP9R Android 14 kernel is 5.x/6.x, so path_umount is usually present.
# Keep false unless your kernel tree explicitly lacks it.
ENABLE_PATH_UMOUNT=false
ENABLE_HIDE_STUFF=true

ADD_OVERLAYFS_CONFIG=true
ADD_KPROBES_CONFIG=true
DISABLE_LTO=false
DISABLE_CC_WERROR=true
EXTRA_DEFCONFIG=

NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
